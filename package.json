{
  "name": "aipack",
  "version": "1.2.3",
  "description": "A lightweight personal AI assistant framework",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:agent": "pnpm --filter @aipack-ai/agent build",
    "build:cli": "pnpm --filter @aipack-ai/cli build",
    "cli": "node packages/cli/dist/bin.js",
    "cli:dev": "tsx packages/cli/src/bin.ts",
    "example:deepseek": "tsx examples/deepseek.ts",
    "example:agent-memory": "tsx examples/agent-memory.ts",
    "example:compression": "tsx examples/compression-demo.ts",
    "example:permission": "tsx examples/permission-approval.ts",
    "example:mcp": "tsx examples/mcp-client.ts",
    "example:mcp-server": "tsx examples/mcp-server.ts",
    "example:ma-pipeline": "tsx examples/multi-agent-pipeline.ts",
    "example:ma-router": "tsx examples/multi-agent-router.ts",
    "example:ma-supervisor": "tsx examples/multi-agent-supervisor.ts",
    "example:ma-debate": "tsx examples/multi-agent-debate.ts",
    "example:ma-mapreduce": "tsx examples/multi-agent-mapreduce.ts",
    "example:ma-custom": "tsx examples/multi-agent-custom.ts",
    "lint": "tsc --noEmit",
    "docs:dev": "pnpm --dir web-docs dev",
    "docs:build": "pnpm --dir web-docs build",
    "docs:preview": "pnpm --dir web-docs preview",
    "docs:typecheck": "pnpm --dir web-docs typecheck",
    "docs:deploy": "pnpm --dir web-docs deploy:prod",
    "docs:deploy:preview": "pnpm --dir web-docs deploy:preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "ai",
    "agent",
    "chatbot"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.0 <0.28.1": ">=0.28.1",
      "nanoid@<3.3.18": ">=3.3.18",
      "js-yaml": "^4.3.2",
      "read-yaml-file": "^2.1.0"
    }
  },
  "dependencies": {
    "@aipack-ai/agent": "workspace:*"
  },
  "devDependencies": {
    "@aipack-ai/cli": "workspace:*",
    "@aipack-ai/compression": "workspace:*",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.12.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
