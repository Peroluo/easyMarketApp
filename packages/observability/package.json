{
  "name": "@aipack-ai/observability",
  "version": "1.2.3",
  "description": "aipack 可观测性上报 SDK(S2)：埋点上报模式，appId+appSecret 一行接入，失败本地缓存补报",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prebuild": "[ -f ../agent/dist/index.d.ts ] || pnpm --filter @aipack-ai/agent build || true",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/observability.test.ts"
  },
  "keywords": [
    "aipack",
    "observability",
    "telemetry",
    "metrics",
    "trace"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@aipack-ai/agent": "workspace:*"
  },
  "devDependencies": {
    "@aipack-ai/agent": "workspace:*",
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
