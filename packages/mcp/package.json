{
  "name": "@aipack-ai/mcp",
  "version": "1.1.10",
  "description": "aipack MCP 插件：连接外部 MCP Server（客户端方向）并把其工具包装为原生 Tool，零运行时依赖",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server/stdio-entry": {
      "types": "./dist/server/stdio-entry.d.ts",
      "import": "./dist/server/stdio-entry.js"
    },
    "./server/http-entry": {
      "types": "./dist/server/http-entry.d.ts",
      "import": "./dist/server/http-entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prebuild": "[ -f ../agent/dist/index.d.ts ] || pnpm --filter @aipack-ai/agent build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "aipack",
    "mcp",
    "model-context-protocol",
    "agent",
    "plugin",
    "tool"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@aipack-ai/agent": "workspace:*"
  },
  "devDependencies": {
    "@aipack-ai/agent": "workspace:*",
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0"
  }
}
