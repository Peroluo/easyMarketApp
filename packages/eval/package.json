{
  "name": "@aipack-ai/eval",
  "version": "1.2.3",
  "description": "aipack Eval 体系：EvalCase 格式 + 规则评分器 + Runner（mock fixture replay）+ 报告与 baseline 门禁",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aipack-eval": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-imports.mjs",
    "prebuild": "[ -f ../agent/dist/index.d.ts ] || pnpm --filter @aipack-ai/agent build",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "eval": "node --import tsx src/cli.ts run",
    "eval:live": "node --import tsx src/cli.ts run --mode live"
  },
  "keywords": [
    "aipack",
    "eval",
    "agent",
    "benchmark",
    "scorer"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aipack-ai/agent": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0"
  }
}
