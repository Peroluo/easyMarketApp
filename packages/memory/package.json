{
  "name": "@aipack-ai/memory",
  "version": "1.2.2",
  "description": "aipack 持久化记忆插件：capture → compress → index → recall/inject → consolidate",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prebuild": "[ -f ../agent/dist/index.d.ts ] || pnpm --filter @aipack-ai/agent build",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "example": "node --import tsx examples/round-trip.ts"
  },
  "keywords": [
    "aipack",
    "memory",
    "agent",
    "bm25",
    "context",
    "retrieval"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@aipack-ai/agent": "workspace:*"
  },
  "devDependencies": {
    "@aipack-ai/agent": "workspace:*",
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "tsx": "^4.16.0"
  }
}
