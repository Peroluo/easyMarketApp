{
  "name": "@aipack-ai/cli",
  "version": "1.1.10",
  "description": "aipack CLI - 基于 @aipack-ai/agent 的终端 AI 助手",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aipack": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prebuild": "for p in agent compression mcp; do [ -f ../$p/dist/index.d.ts ] || pnpm --filter @aipack-ai/$p build; done",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx src/bin.ts"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "llm",
    "aipack"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.19.0"
  },
  "dependencies": {
    "@aipack-ai/agent": "workspace:*",
    "@aipack-ai/compression": "workspace:*",
    "@aipack-ai/mcp": "workspace:*",
    "@aipack-ai/skills": "workspace:*",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
