{
  "name": "@aipack-ai/compression",
  "version": "1.3.1",
  "description": "aipack 上下文压缩 v2：双水位预算（trigger/target/precompress）+ 策略管道（trim 无损裁剪 -> summarize 有损摘要 -> truncate 保底）+ 后台预压缩 + 上下文耗尽事件",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prebuild": "[ -f ../agent/dist/index.d.ts ] || pnpm --filter @aipack-ai/agent build || true",
    "typecheck": "tsc --noEmit",
    "example": "node --import tsx examples/compression-demo.ts",
    "test": "node --import tsx --test test/budget.test.ts test/estimator.test.ts test/strategies.test.ts test/transformer.test.ts test/round-trip.test.ts test/safety.test.ts test/retry.test.ts"
  },
  "keywords": [
    "aipack",
    "compression",
    "context",
    "agent",
    "compaction",
    "summarization",
    "hysteresis"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@aipack-ai/agent": "workspace:*"
  },
  "devDependencies": {
    "@aipack-ai/agent": "workspace:*",
    "@types/node": "^20.12.0",
    "tsup": "^8.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
