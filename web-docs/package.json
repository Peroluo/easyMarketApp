{
  "name": "@aipack-ai/docs",
  "version": "1.2.1",
  "private": true,
  "description": "aipack 框架文档网站 - 包含使用指南、API 文档、扩展教程和示例代码",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:preview": "netlify deploy --build",
    "deploy:prod": "netlify deploy --build --prod"
  },
  "keywords": [
    "aipack",
    "docs",
    "documentation",
    "react",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "antd": "^5.20.0",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^6.4.3"
  }
}
